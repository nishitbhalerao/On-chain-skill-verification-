# Stellar Account Configuration
STELLAR_ACCOUNT=your_stellar_public_key_here
STELLAR_SECRET_KEY=your_stellar_secret_key_here

# Soroban Configuration
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK=testnet

# Contract Paths
CONTRACT_WASM_PATH=target/wasm32-unknown-unknown/release/skill_oracle.wasm

# Optional: Already deployed contract ID (for interaction)
DEPLOYED_CONTRACT_ID=

# Horizon Configuration (for sending transactions)
HORIZON_URL=https://horizon-testnet.stellar.org

# Network Passphrase
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
